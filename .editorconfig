root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cpp,h,hpp,ps1,py}]
indent_style = space
indent_size = 4

[*.{xaml,xml,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[docs/licenses/**]
# Preserve upstream license material byte-for-byte.
insert_final_newline = unset
trim_trailing_whitespace = unset
charset = unset
