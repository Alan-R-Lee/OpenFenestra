<Window x:Class="OpenFenestra.App.FenceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenFenestra 分组" Width="340" Height="340" MinWidth="260" MinHeight="180" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Style="{StaticResource {x:Type Window}}">
  <Border x:Name="Surface" CornerRadius="14" BorderBrush="#60FFFFFF" BorderThickness="1" Background="#F020302E" Padding="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Border x:Name="Header" Background="Transparent" CornerRadius="12,12,0,0" MouseLeftButtonDown="OnHeaderDown" Cursor="SizeAll">
        <Grid Margin="14,0,7,0"><Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <Border x:Name="Accent" Width="4" Height="18" CornerRadius="2"/>
          <TextBlock x:Name="GroupTitle" Grid.Column="1" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="2" Content="−" Padding="5" Margin="0" Background="Transparent" Foreground="#DEFFFFFF" ToolTip="折叠 / 展开" Click="OnCollapse"/>
          <Button Grid.Column="3" Content="···" Padding="5" Margin="0" Background="Transparent" Foreground="White" ToolTip="分组菜单" Click="OnMenu"/>
        </Grid>
      </Border>
      <DockPanel x:Name="TabBar" Grid.Row="1" Margin="12,0,10,7"><Button DockPanel.Dock="Right" Content="+" Padding="8,4" Margin="3,0,0,0" Background="#1FFFFFFF" Foreground="White" ToolTip="添加标签页" Click="OnAddTab"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Tabs" Orientation="Horizontal"/></ScrollViewer></DockPanel>
      <Grid x:Name="SearchArea" Grid.Row="2" Margin="12,0,12,8"><TextBox x:Name="Search" Background="#1CFFFFFF" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="9,6" ToolTip="搜索当前标签页" TextChanged="OnSearchChanged"/><TextBlock Text="⌕  搜索当前标签页" Foreground="#90FFFFFF" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Grid x:Name="ContentArea" Grid.Row="3" Margin="6,0">
        <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnOpen" PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseMove="OnItemMouseMove" KeyDown="OnItemKeyDown">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="2"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><EventSetter Event="ContextMenuOpening" Handler="OnItemContext"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel Width="78" Height="88" ToolTip="{Binding Path}" Opacity="{Binding ItemOpacity}"><Image Source="{Binding Icon}" Width="36" Height="36" Margin="0,4,0,7"/><TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" FontSize="11" Foreground="White"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Foreground="#AFFFFFFF" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False" LineHeight="24"/>
      </Grid>
      <TextBlock x:Name="Footnote" Grid.Row="4" Margin="14,5,20,0" Foreground="#AFFFFFFF" FontSize="10" TextTrimming="CharacterEllipsis"/>
      <Thumb x:Name="ResizeGrip" Grid.Row="4" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"><Thumb.Template><ControlTemplate><TextBlock Text="◢" Foreground="#70FFFFFF" FontSize="12"/></ControlTemplate></Thumb.Template></Thumb>
    </Grid>
  </Border>
</Window>
