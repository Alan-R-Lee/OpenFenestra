<Window x:Class="OpenFenestra.App.FenceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenFenestra 分栏" Width="360" Height="340" MinWidth="220" MinHeight="180" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesktopScrollBars.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border x:Name="Surface" CornerRadius="5" BorderBrush="#26FFFFFF" BorderThickness="1" Background="#94151C22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="10"/></Grid.RowDefinitions>
      <Border x:Name="Header" Background="#16FFFFFF" CornerRadius="4,4,0,0" MouseLeftButtonDown="OnHeaderDown" MouseMove="OnHeaderMove" MouseLeftButtonUp="OnHeaderUp" ToolTip="双击折叠；单击展开；拖动栏头移动">
        <Grid Margin="10,0,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
          <Border x:Name="Accent" Width="3" Height="13" CornerRadius="1"/>
          <TextBlock x:Name="GroupTitle" Grid.Column="1" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="2" Content="⌕" Padding="3" Margin="0" Background="Transparent" Foreground="#CFFFFFFF" ToolTip="搜索" Click="OnSearchToggle"/>
          <Button x:Name="CollapseButton" Grid.Column="3" Content="−" Padding="3" Margin="0" Background="Transparent" Foreground="#CFFFFFFF" ToolTip="折叠 / 展开" Click="OnCollapse"/>
          <Button Grid.Column="4" Content="···" Padding="3" Margin="0" Background="Transparent" Foreground="White" ToolTip="分栏菜单" Click="OnMenu"/>
        </Grid>
      </Border>
      <DockPanel x:Name="TabBar" Grid.Row="1" Margin="7,4,5,1"><Button x:Name="OrganizeRecentButton" DockPanel.Dock="Right" Content="一键归类" Padding="7,2" Margin="2,0,0,0" Visibility="Collapsed" ToolTip="将最近项目按类型归入分类分栏，保留原文件" Click="OnOrganizeRecent"/><Button x:Name="SortButton" DockPanel.Dock="Right" Content="常用 ▾" Padding="5,3" Margin="3,0,0,0" FontSize="10" Background="#18FFFFFF" Foreground="White" ToolTip="图标排序：常用优先、新加入优先或原有顺序" Click="OnSortMenu"/><Button x:Name="AddTabButton" DockPanel.Dock="Right" Content="+" Padding="7,2" Margin="2,0,0,0" Background="#12FFFFFF" Foreground="#CFFFFFFF" ToolTip="添加标签页" Click="OnAddTab"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Tabs" Orientation="Horizontal"/></ScrollViewer></DockPanel>
      <Grid x:Name="SearchArea" Grid.Row="2" Margin="8,4,8,5" Visibility="Collapsed"><TextBox x:Name="Search" Background="#1CFFFFFF" Foreground="White" CaretBrush="White" BorderThickness="0" Padding="8,4" ToolTip="搜索当前标签页" TextChanged="OnSearchChanged"/></Grid>
      <Border x:Name="LocationArea" Grid.Row="3" Margin="8,4,8,2" Padding="7" CornerRadius="5" Background="#2678B9A1" Visibility="Collapsed">
        <StackPanel>
          <DockPanel><Button x:Name="ClearLocationButton" Content="×" MinWidth="22" ToolTip="清除定位，恢复当前排序" AutomationProperties.Name="清除定位" DockPanel.Dock="Right" Click="OnClearLocation" Padding="5,2" Margin="5,0,0,0" FontSize="10" Foreground="White" Background="#18FFFFFF"/><TextBlock x:Name="LocationText" Foreground="#E7FFF3" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="70"><WrapPanel x:Name="DestinationLinks"/></ScrollViewer>
        </StackPanel>
      </Border>
      <Grid x:Name="ContentArea" Grid.Row="4" Margin="5,4,5,0">
        <ListBox x:Name="Items" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnOpen" PreviewMouseLeftButtonDown="OnItemMouseDown" PreviewMouseMove="OnItemMouseMove" KeyDown="OnItemKeyDown">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="1"/><Setter Property="Margin" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><EventSetter Event="ContextMenuOpening" Handler="OnItemContext"/><EventSetter Event="PreviewMouseRightButtonUp" Handler="OnItemRightUp"/><Style.Triggers><DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Background" Value="#2678B9A1"/><Setter Property="BorderBrush" Value="#6578B9A1"/><Setter Property="BorderThickness" Value="1"/></DataTrigger><DataTrigger Binding="{Binding IsLocated}" Value="True"><Setter Property="Background" Value="#5078B9A1"/><Setter Property="BorderBrush" Value="#CCACE5C5"/><Setter Property="BorderThickness" Value="1"/></DataTrigger></Style.Triggers></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel Width="96" Height="{Binding TileHeight}" ToolTip="{Binding ActivityHint}" Opacity="{Binding ItemOpacity}"><Grid><Image Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}" Margin="0,7,0,6" RenderOptions.BitmapScalingMode="HighQuality"/><Border Background="#387C5C" CornerRadius="3" Padding="3,1" Margin="0,1,1,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding NewBadgeVisibility}" ToolTip="新加入的图标，首次通过 OpenFenestra 打开后取消标记"><TextBlock Text="新增" Foreground="White" FontSize="9"/></Border></Grid><TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" FontSize="12" Foreground="White"></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Empty" Foreground="#AFFFFFFF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="16" IsHitTestVisible="False" LineHeight="22"/>
      </Grid>
      <TextBlock x:Name="Footnote" Grid.Row="5" Visibility="Collapsed"/>
      <Thumb x:Name="ResizeGrip" Grid.Row="5" Width="18" Height="18" ToolTip="拖动调整本分栏的宽度与高度" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="OnResize"><Thumb.Template><ControlTemplate><TextBlock Text="◢" Foreground="#50FFFFFF" FontSize="9"/></ControlTemplate></Thumb.Template></Thumb>
    </Grid>
  </Border>
</Window>
