<Window x:Class="OpenFenestra.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenFenestra · 桌面，自有条理" Width="1120" Height="780" MinWidth="940" MinHeight="650" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <Style x:Key="SidebarNavigation" TargetType="RadioButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C8DCCF"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="16,11"/>
      <Setter Property="Margin" Value="-8,0,0,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="NavigationSurface" CornerRadius="8" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent">
            <Grid>
              <Border x:Name="SelectedMarker" Width="3" Height="18" CornerRadius="1.5" Background="#D7EBC7" HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="Collapsed"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationSurface" Property="Background" Value="#2B5445"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="NavigationSurface" Property="Background" Value="#3A6854"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="SelectedMarker" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavigationSurface" Property="Background" Value="#497A62"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavigationSurface" Property="BorderBrush" Value="#B7D7C0"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#F5F6F2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#183E32" Padding="24,31,20,20">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <Border Width="40" Height="40" CornerRadius="12" Background="#DAECCB" HorizontalAlignment="Left" Margin="0,0,0,16"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="3"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="3"/><RowDefinition/></Grid.RowDefinitions><Border Background="#245B47" CornerRadius="2"/><Border Grid.Column="2" Grid.RowSpan="3" Background="#245B47" CornerRadius="2"/><Border Grid.Row="2" Background="#245B47" CornerRadius="2"/></Grid></Border>
          <TextBlock Text="OpenFenestra" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="给每一份灵感，一个位置。" FontSize="11" Foreground="#A9C7B6" Margin="0,9,0,40"/>
          <RadioButton x:Name="GroupsNavigation" Content="▦    桌面分组" Style="{StaticResource SidebarNavigation}" GroupName="SidebarPages" IsChecked="True" Tag="groups" Checked="OnNavigate"/>
          <RadioButton x:Name="SnapshotsNavigation" Content="◷    布局快照" Style="{StaticResource SidebarNavigation}" GroupName="SidebarPages" Tag="snapshots" Checked="OnNavigate"/>
          <RadioButton x:Name="GuideNavigation" Content="?    使用指南" Style="{StaticResource SidebarNavigation}" GroupName="SidebarPages" Tag="guide" Checked="OnNavigate"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Border Background="#244B3D" CornerRadius="10" Padding="13" Margin="0,0,0,20"><StackPanel><TextBlock Text="你的桌面，始终在手边" Foreground="#E2EDDF" FontSize="11"/><TextBlock Text="Ctrl + Alt + Space" Foreground="#ACD6B6" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="一键速览所有分组" Foreground="#9FBFAE" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
          <TextBlock Text="开源 · 本地存储 · 自由整理" Foreground="#93B19F" FontSize="10"/><TextBlock Text="v0.3.5  /  原生桌面实验版" Foreground="#6F9A83" FontSize="10" Margin="0,7,0,0"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,29,34,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22">
        <Button DockPanel.Dock="Right" Content="收起到托盘 ↘" Padding="12,8" Margin="0" Click="OnTray"/>
        <TextBlock Text="WORKSPACE  /  我的桌面" FontSize="10" Foreground="#829086" VerticalAlignment="Center" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid x:Name="GroupsPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="桌面，自有条理。" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="把常用留在眼前，把杂乱交给分组。" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="＋ 新建分组" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="0" Click="OnCreate"/></Grid>
          <Border Grid.Row="1" Background="#E8EFDF" CornerRadius="14" Padding="23,18" Margin="0,0,0,20">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="让桌面，轻一点" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="按类型收纳桌面项目，原文件保留在原位置。" Foreground="#677E64" FontSize="12" Margin="0,7,0,0"/></StackPanel><Button Grid.Column="1" Content="一键归类桌面  ↗" Background="#D5E2C8" Margin="16,0,0,0" VerticalAlignment="Center" Click="OnOrganize"/></Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="GroupCount" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="桌面分组" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock x:Name="ReferenceCount" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="文件引用" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock x:Name="PortalCount" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="实时文件夹" Style="{StaticResource Caption}" FontSize="11"/></StackPanel>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,0,0,13"><Grid DockPanel.Dock="Right" Width="190"><TextBox x:Name="GroupSearch" Padding="10,6" ToolTip="搜索分组名称或标签页" TextChanged="OnSearch"/><TextBlock Text="⌕  搜索分组" Foreground="#879286" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=GroupSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock Text="我的分组" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
          <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <Border x:Name="EmptyState" CornerRadius="12" BorderBrush="#DCE3D7" BorderThickness="1" Padding="24" Margin="0,0,0,18"><StackPanel><TextBlock Text="从一个分组开始" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="新建一个收纳盒，或一键归类现有桌面。&#10;也可以映射一个文件夹，让内容随时更新。" Style="{StaticResource Caption}" Margin="0,8,0,14"/><Button Content="创建我的第一个分组  →" HorizontalAlignment="Left" Click="OnCreate"/></StackPanel></Border>
              <Border Background="#EDF0E9" CornerRadius="10" Padding="16,13" Margin="0,0,0,14"><StackPanel>
                <TextBlock Text="统一透明度" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="调整所有分栏的背景，数值越大越透明；图标保持清晰。" Foreground="#7E897F" FontSize="11" Margin="0,5,0,10" TextWrapping="Wrap"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                  <TextBlock Text="展开背景透明度" VerticalAlignment="Center" FontSize="12"/>
                  <Slider x:Name="ExpandedTransparency" Grid.Column="1" Minimum="0" Maximum="85" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" ValueChanged="OnTransparencyChanged" ToolTip="实时应用到所有分栏的展开背景" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ExpandedTransparencyValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                </Grid>
                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                  <TextBlock Text="折叠背景透明度" VerticalAlignment="Center" FontSize="12"/>
                  <Slider x:Name="CollapsedTransparency" Grid.Column="1" Minimum="35" Maximum="94" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" ValueChanged="OnTransparencyChanged" ToolTip="实时应用到所有分栏的折叠背景" VerticalAlignment="Center"/>
                  <TextBlock x:Name="CollapsedTransparencyValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/>
                </Grid>
              </StackPanel></Border>
              <ItemsControl x:Name="GroupCards"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DEE4DA" BorderThickness="1" Background="White" CornerRadius="12" Margin="0,0,0,10" Padding="16,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{Binding Color}" Width="4" CornerRadius="2" Margin="0,2,0,2"/><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#7C8A7F" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding VisibilityLabel}" Tag="{Binding Id}" Padding="11,7" Click="OnToggleGroup"/><Button Content="编辑" Tag="{Binding Id}" Padding="11,7" Margin="0" Click="OnEditGroup"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Border Background="#EDF0E9" CornerRadius="10" Padding="15,7" Margin="0,8,0,0"><StackPanel><WrapPanel Margin="0,4,0,5"><Button Content="整理分栏位置" Click="OnArrange" Padding="10,6"/><Button Content="折叠全部" Click="OnCollapseAll" Padding="10,6"/><Button Content="展开全部" Click="OnExpandAll" Padding="10,6"/><Button Content="退出应用" Click="OnExitApp" Padding="10,6"/></WrapPanel><CheckBox x:Name="DesktopSetting" Content="原生桌面整合（实验）：收纳后不重复显示图标" Checked="OnDesktopSetting" Unchecked="OnDesktopSetting"/><TextBlock Text="保留 Windows 桌面；关闭此项或退出应用后恢复图标。" Foreground="#7E897F" FontSize="10" TextWrapping="Wrap" Margin="19,0,0,5"/><CheckBox x:Name="StartupSetting" Content="开机自动运行，并恢复上次布局" Checked="OnStartupSetting" Unchecked="OnStartupSetting"/><CheckBox x:Name="PinSetting" Content="分栏保持在桌面层并跨虚拟桌面显示" Checked="OnSettings" Unchecked="OnSettings"/><CheckBox x:Name="AutoSetting" Content="自动归类新增桌面项目" Checked="OnSettings" Unchecked="OnSettings"/></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="SnapshotsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,25"><TextBlock Text="留住喜欢的布局。" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="快照保存分组、标签页和位置。恢复前会自动备份当前布局。" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel>
          <WrapPanel Grid.Row="1" Margin="0,0,0,20"><Button Content="＋ 保存当前快照" Style="{StaticResource PrimaryButton}" Click="OnSnapshot"/><Button Content="导出布局…" Click="OnExport"/><Button Content="导入布局…" Click="OnImport"/></WrapPanel>
          <TextBlock Grid.Row="2" Text="最近的快照 · 选中后点击恢复" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
          <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListBox x:Name="SnapshotList" DisplayMemberPath="Name" Background="White" BorderBrush="#DCE3D7" Padding="10"/><Button Grid.Row="1" Content="恢复选中的布局" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OnRestore"/></Grid>
        </Grid>
        <ScrollViewer x:Name="GuidePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="桌面整理，按你的方式。" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
          <TextBlock Text="01 / 创建与收纳" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="把桌面图标拖进分栏即可收纳，拖回空白桌面即可移出。双击项目打开；双击栏头折叠，折叠后单击展开并恢复透明度。拖动栏头移动，拖动右下角缩放。" Style="{StaticResource Caption}" Margin="0,10,0,23"/>
          <TextBlock Text="02 / 标签页与文件夹" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="通过分栏菜单添加标签页；多个标签页时也可点击 +。右键标签页编辑，填写文件夹路径后成为实时映射。映射页只读浏览，不接受拖入，不改变文件位置。" Style="{StaticResource Caption}" Margin="0,10,0,23"/>
          <TextBlock Text="03 / 搜索与速览" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="面板搜索框筛选当前标签页；管理窗口筛选分组名称和标签页。按 Ctrl+Alt+Space 置顶速览，再按一次恢复。托盘菜单可以显示、隐藏所有分组或退出。关闭管理窗口后，面板仍在运行。" Style="{StaticResource Caption}" Margin="0,10,0,23"/>
          <TextBlock Text="04 / 放心试，随时回去" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="移除项目只移除引用，原文件保留。移除分组或标签页前自动保存快照。布局自动保存，导入或恢复前也会留一份快照。导出的布局包含本机文件路径，分享前请自行检查。" Style="{StaticResource Caption}" Margin="0,10,0,23"/>
          <Border Background="#E8EFDF" CornerRadius="12" Padding="18"><TextBlock Text="原生桌面整合保留 Windows 桌面，只让已收纳项目停止在原位置绘制。图标对应的文件始终留在原处，退出后恢复显示。开机自动运行会在登录后恢复分栏、标签页及折叠状态。拖回空白桌面可放回；外部文件会创建真实桌面快捷方式。" Foreground="#536C52" TextWrapping="Wrap" LineHeight="24"/></Border>
          <Button Content="打开本地配置目录 ↗" HorizontalAlignment="Left" Margin="0,20,0,12" Click="OnOpenData"/>
        </StackPanel></ScrollViewer>
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#7E8B7D" FontSize="10" Margin="0,17,0,0" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Window>
